<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required by every networked mode: Play Online (Firestore) and Play
         Nearby (the LAN WebSocket server/client plus the UDP discovery beacon).

         It must live in THIS manifest, not only in src/debug and src/profile:
         those variants are merged into debug/profile builds alone, so a RELEASE
         APK built without this line has no INTERNET permission at all — every
         socket fails and both remote modes are dead on a shipped build while
         working perfectly in development. No plugin in this app contributes the
         permission through manifest merging, so nothing else supplies it. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- TWO features now, and both need this one line. Play Nearby's QR join:
         the guest points its camera at the code on the host's screen. Buddy
         Mode: the phone watches a physical board for a whole match. Same rule
         as INTERNET above — it must live in THIS manifest, not only in
         src/debug, or both are dead on a release build while working perfectly
         in development. Neither mobile_scanner nor camera contributes the
         permission by merging; they only request it at runtime, and a runtime
         request for a permission the manifest never declared is denied
         outright.

         Android grants CAMERA at runtime, so declaring it here costs nothing
         until the user actually taps "Scan QR code" or starts a Buddy match. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Buddy Mode's dice-roll listener: a transient detector on the mic's
         amplitude stream that tells perception when to look. It is STRICTLY an
         attention hint — the mode works identically with this permission
         denied — so it is asked for in context, at the first Buddy session,
         and a refusal is remembered rather than re-nagged. Declared here for
         the same reason as CAMERA: a runtime request for an undeclared
         permission never reaches the user at all. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Scanning is one optional path into a LAN game (discovery and typed
         addresses are the others), so a device with no camera must still be
         able to install the app. Without this, declaring CAMERA would make the
         hardware an implicit Play Store requirement. The microphone entry says
         the same thing for RECORD_AUDIO, and more strongly: the dice listener
         is an optimization inside an optional mode, so it must never be able
         to cost the app an install. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- Deliberately NO usesCleartextTraffic and no network_security_config, even
         though Play Nearby dials a plain `ws://` LAN address and API 28+ blocks
         cleartext by default.

         That default does not reach this code. Android enforces it through
         NetworkSecurityPolicy, which java.net / OkHttp / WebView consult — and
         `dart:io` does not: WebSocket.connect and HttpClient are implemented in the
         VM over raw POSIX sockets. So a cleartext exception here would buy nothing,
         while a global usesCleartextTraffic="true" would weaken the app's posture
         for the native layers that DO honour the policy.

         Recorded because "Android is blocking cleartext" is the obvious first guess
         when a LAN join fails, and it is the wrong one — the shipped join hang was
         a dropped handshake frame in Dart (see SocketTransport.host). Revisit only
         if a plugin or platform channel, rather than dart:io, ever needs http://. -->

    <application
        android:label="AIGammon"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
