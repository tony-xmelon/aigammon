<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AI Gammon</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AI Gammon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Nearby (LAN) play: the host binds a local TCP port and both devices
	     exchange UDP discovery datagrams on the Wi-Fi. iOS shows this string in
	     the local-network permission prompt. See native/README.md for the
	     multicast-entitlement caveat — manual address entry works without it. -->
	<!-- TWO features share this one prompt, and iOS only ever shows it once, so
	     the string has to be true for both:

	       * Nearby (LAN) play, QR join — the guest scans the code on the host's
	         screen to pick up its address, port and room code;
	       * Buddy Mode — the phone watches a physical board for a whole match.

	     App Review rejects a build that links a camera API without this key,
	     and iOS terminates the process on first use. Declining it is not a dead
	     end for either feature: the Join tab still finds hosts by discovery and
	     takes a typed address, and Buddy Mode is one mode among several. -->
	<key>NSCameraUsageDescription</key>
	<string>AI Gammon uses the camera to scan the QR code shown by another device, and — in Buddy Mode — to watch your physical board so it can follow the game.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>AI Gammon uses the local network to find and play against another device on the same Wi-Fi.</string>
	<!-- Buddy Mode's dice-roll listener: a transient detector that tells
	     perception when to look at the board. STRICTLY an attention hint — the
	     mode works identically with this denied — so the string promises
	     nothing more than listening for the dice, and the app asks in context
	     at the first Buddy session rather than at launch. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>AI Gammon can listen for the sound of your dice landing, so Buddy knows when to look at the board. Buddy Mode works without this.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
